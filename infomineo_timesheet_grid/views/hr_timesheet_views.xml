<odoo>
    <record id="timesheet_view_tree_colored" model="ir.ui.view">
        <field name="name">account.analytic.line.tree.hr_timesheet</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="timesheet_grid.timesheet_view_tree_colored" />
        <field name="arch" type="xml">
            <field name="validated" position="attributes">
                <attribute name="invisible">0</attribute>
            </field>
            <xpath expr="//field[@name='unit_amount']" position="before">
                <field name="validated_on" />
            </xpath>
        </field>
    </record>

    <record id="timesheet_form_view" model="ir.ui.view">
        <field name="name">account.analytic.line.kanban.timesheet_grid</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="timesheet_grid.timesheet_form_view" />
        <field name="arch" type="xml">
            <field name="validated" position="attributes">
                <attribute name="invisible">0</attribute>
            </field>
            <xpath expr="//field[@name='unit_amount']" position="after">
                <field name="validated" position="move" />
            </xpath>
        </field>
    </record>

    <record id="timesheet_view_form" model="ir.ui.view">
        <field name="name">account.analytic.line.form</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="timesheet_grid.timesheet_view_form" />
        <field name="arch" type="xml">
            <field name="validated" position="attributes">
                <attribute name="invisible">0</attribute>
            </field>
            <xpath expr="//field[@name='unit_amount']" position="after">
                <field name="validated" position="move" />
            </xpath>
            <field name="task_id" position="attributes">
                <attribute name="required">1</attribute>
            </field>
        </field>
    </record>
</odoo>
