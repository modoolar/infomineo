<?xml version="1.0" encoding="utf-8" ?>
<odoo noupdate="0">
    <record id="ir_cron_annual_timeoff_allocation" model="ir.cron">
        <field name='name'>Annually allocate time off/sick leave</field>
        <field name='interval_number'>12</field>
        <field name='interval_type'>months</field>
        <field name="numbercall">-1</field>
        <field name="active" eval="False" />
        <field name="doall" eval="False" />
        <field name="code">model.allocate_annual_employee_time_off()</field>
        <field name="state">code</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field
            name="nextcall"
            eval="(datetime.now() + relativedelta(years=1)).strftime('%Y-01-01 00:00:00')"
        />
    </record>
</odoo>
