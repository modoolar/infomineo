<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_hr_coach" model="res.groups">
        <field name="name">HR Coach</field>
        <field
            name="category_id"
            ref="base.module_category_human_resources_employees"
        />
        <field
            name="implied_ids"
            eval="[(6, 0, [ref('hr_attendance.group_hr_attendance_kiosk')])]"
        />
    </record>

    <record id="hr.group_hr_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('infomineo_hr_attendance.group_hr_coach'))]"
        />
    </record>

    <record id="hr_attendance.group_hr_attendance_user" model="res.groups">
        <field
            name="implied_ids"
            eval="[(4, ref('infomineo_hr_attendance.group_hr_coach'))]"
        />
    </record>

    <record model="ir.rule" id="hr_coach_pdc_own_employees_rule">
        <field name="name">HR Coach sees only his Employees</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field
            name="domain_force"
        >['|', ('coach_id', '=', user.employee_id.id), ('user_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_hr_attendance.group_hr_coach'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
        <field name="perm_write" eval="False" />
    </record>

    <record model="ir.rule" id="ir_default_system_rule">
        <field name="name">HR Officer sees all Employees</field>
        <field name="model_id" ref="hr.model_hr_employee" />
        <field name="domain_force">[(1,'=',1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="True" />
        <field name="perm_write" eval="True" />
    </record>
</odoo>
