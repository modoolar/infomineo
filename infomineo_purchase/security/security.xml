<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_all_purchase_orders" model="res.groups">
        <field name="name">View all purchase orders</field>
        <field name="category_id" ref="base.module_category_hidden" />
    </record>
    <record model="ir.rule" id="infomineo_purchase_order_all_rule">
        <field name="name">See all Purchase Orders</field>
        <field name="model_id" ref="purchase.model_purchase_order" />
        <field name="domain_force">[(1,'=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_purchase.group_all_purchase_orders'))]"
        />
    </record>
    <record model="ir.rule" id="infomineo_purchase_order_accessible_rule">
        <field name="name">See accessible Purchase Orders</field>
        <field name="model_id" ref="purchase.model_purchase_order" />
        <field
            name="domain_force"
        >['|', ('user_id','=', user.id), ('user_id.employee_id.parent_id.user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('purchase.group_purchase_user'))]" />
    </record>
    <record id="group_team_approver_purchase" model="res.groups">
        <field name="name">Team Approver</field>
        <field name="category_id" ref="base.module_category_inventory_purchase" />
    </record>
    <record model="ir.rule" id="infomineo_purchase_order_team_approver">
        <field name="name">PO Team Approver</field>
        <field name="model_id" ref="purchase.model_purchase_order" />
        <field
            name="domain_force"
        >[('user_id.employee_id.hr_team_id', '=', user.employee_id.hr_team_id.id),
          ('user_id.employee_id', 'in', user.employee_id.child_ids.ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_purchase.group_team_approver_purchase'))]"
        />
    </record>
</odoo>
