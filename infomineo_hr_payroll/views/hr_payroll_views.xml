<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hr_payslip_tree" model="ir.ui.view">
        <field name="name">hr.payslip.tree</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_tree" />
        <field name="arch" type="xml">
            <field name="company_id" position="attributes">
                <attribute
                    name="options"
                >{'no_edit': True, 'no_create': True, 'no_open': True}</attribute>
            </field>
        </field>
    </record>

    <record id="view_hr_payslip_form" model="ir.ui.view">
        <field name="name">hr.payslip.view.form</field>
        <field name="model">hr.payslip</field>
        <field name="inherit_id" ref="hr_payroll.view_hr_payslip_form" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='number_of_days']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='number_of_hours']" position="attributes">
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath
                expr="//page[@name='worked_days_input']//tree/field[@name='number_of_hours']/.."
                position="attributes"
            >
                <attribute name="create">1</attribute>
            </xpath>
            <xpath
                expr="//page[@name='worked_days_input']//tree/field[@name='number_of_hours']/.."
                position="attributes"
            >
                <attribute name="delete">1</attribute>
            </xpath>
            <xpath
                expr="//tree/field[@name='work_entry_type_id']"
                position="attributes"
            >
                <attribute name="readonly">0</attribute>
            </xpath>
            <xpath
                expr="//field[@name='worked_days_line_ids']/tree//field[@name='amount']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='worked_days_line_ids']/tree//field[@name='amount']"
                position="before"
            >
                <field name="manual_amount" force_save="1" />
            </xpath>
            <xpath
                expr="//field[@name='worked_days_line_ids']/form//field[@name='amount']"
                position="attributes"
            >
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath
                expr="//field[@name='worked_days_line_ids']/form//field[@name='amount']"
                position="before"
            >
                <field name="manual_amount" force_save="1" />
            </xpath>
        </field>
    </record>
</odoo>
