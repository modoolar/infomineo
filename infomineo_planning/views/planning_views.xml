<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- planning.slot views -->
    <record id="planning_view_tree" model="ir.ui.view">
        <field name="name">planning.slot.tree</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_tree" />
        <field name="arch" type="xml">
            <field name="resource_id" position="after">
                <field name="hr_team_id" />
                <field name="hr_child_team_id" />
            </field>
        </field>
    </record>

    <record id="planning_view_search" model="ir.ui.view">
        <field name="name">planning.slot.search</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//search//field[@name='role_id']" position="after">
                <field
                    name="hr_team_id"
                    filter_domain="[('hr_team_id', 'ilike', self)]"
                />
            </xpath>
            <filter name="group_by_department" position="after">
                <filter
                    string="HR Team"
                    name="hr_team"
                    context="{'group_by': 'hr_team_id'}"
                />
            </filter>
        </field>
    </record>

</odoo>
