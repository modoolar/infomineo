<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_employee_form_coach" model="ir.ui.view">
        <field name="name">hr.employee.form.coach</field>
        <field name="model">hr.employee</field>
        <field
            name="inherit_id"
            ref="infomineo_hr_attendance.view_employee_form_coach"
        />
        <field name="arch" type="xml">
            <div name="button_box" position="inside">
                <button
                    class="oe_stat_button"
                    type="action"
                    name="%(hr_timesheet.timesheet_action_from_employee)d"
                    icon="fa-calendar"
                    groups="infomineo_hr_attendance.group_hr_coach"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Timesheets</span>
                    </div>
                </button>
            </div>
        </field>
    </record>
</odoo>
