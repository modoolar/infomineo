<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="employee_employment_history_form_view" model="ir.ui.view">
        <field name="name">employee.employment.history.form.view</field>
        <field name="model">employee.employment.history</field>
        <field
            name="inherit_id"
            ref="infomineo_hr.employee_employment_history_form_view"
        />
        <field name="arch" type="xml">
            <field name="coach_id" position="after">
                <field name="current_contract_id" readonly="1" />
                <field name="wage" readonly="1" />
                <field name="currency_id" readonly="1" invisible="1" />
            </field>
        </field>
    </record>

    <record id="employee_employment_history_tree_view" model="ir.ui.view">
        <field name="name">employee.employment.history.tree.view</field>
        <field name="model">employee.employment.history</field>
        <field
            name="inherit_id"
            ref="infomineo_hr.employee_employment_history_tree_view"
        />
        <field name="arch" type="xml">
            <field name="coach_id" position="after">
                <field name="current_contract_id" optional="hide" readonly="1" />
                <field name="wage" readonly="1" />
                <field name="currency_id" readonly="1" invisible="1" />
            </field>
        </field>
    </record>
</odoo>
