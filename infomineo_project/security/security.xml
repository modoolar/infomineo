<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="group_infomineo_project_manager" model="res.groups">
        <field name="name">Project Manager</field>
        <field name="category_id" ref="base.module_category_services_project" />
        <field name="implied_ids" eval="[(4, ref('project.group_project_user'))]" />
    </record>

     <record id="project.group_project_manager" model="res.groups">
            <field
            name="implied_ids"
            eval="[(4, ref('infomineo_project.group_infomineo_project_manager'))]"
        />
        </record>

    <record id="project_user_project_own_rule" model="ir.rule">
        <field name="name">Project User Own Project Rule</field>
        <field name="model_id" ref="project.model_project_project" />
        <field
            name="domain_force"
        >['|',('user_id', '=', user.id),('project_team_members_ids', 'in', user.ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]" />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project_manager_project_own_rule" model="ir.rule">
        <field name="name">Project Manager Own Project Rule</field>
        <field name="model_id" ref="project.model_project_project" />
        <field
            name="domain_force"
        >['|',('user_id', '=', user.id),('project_team_members_ids', 'in', user.ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_project.group_infomineo_project_manager'))]"
        />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project_manager_project_no_owner_rule" model="ir.rule">
        <field name="name">Project Manager No Owner Project Rule</field>
        <field name="model_id" ref="project.model_project_project" />
        <field name="domain_force">[('user_id', '=', False)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_project.group_infomineo_project_manager'))]"
        />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project_manager_task_rule" model="ir.rule">
        <field name="name">Project Manager Own Task Rule</field>
        <field name="model_id" ref="project.model_project_task" />
        <field
            name="domain_force"
        >['|', '|',('project_id.user_id', '=', user.id), ('project_id.user_id', '=', False), ('project_id.project_team_members_ids', 'in', user.ids)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_project.group_infomineo_project_manager'))]"
        />
    </record>

    <record id="project_user_task_rule" model="ir.rule">
        <field name="name">Project User Own Task Rule</field>
        <field name="model_id" ref="project.model_project_task" />
        <field
            name="domain_force"
        >[('project_id.project_team_members_ids', 'in', user.ids),('user_ids', 'in', user.ids)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project_manager_analytic_line_rule" model="ir.rule">
        <field name="name">Project Manager Timesheet Rule</field>
        <field name="model_id" ref="analytic.model_account_analytic_line" />
        <field
            name="domain_force"
        >['|',('project_id.user_id', '=', user.id),('project_id.project_director_id', '=', user.id)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_project.group_infomineo_project_manager'))]"
        />
        <field name="perm_create" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_unlink" eval="True" />
    </record>

    <record id="project_manager_no_owner_analytic_line_rule" model="ir.rule">
        <field name="name">Project Manager Timesheet No Owner Rule</field>
        <field name="model_id" ref="analytic.model_account_analytic_line" />
        <field name="domain_force">[('project_id.user_id', '=', False)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_project.group_infomineo_project_manager'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project_user_analytic_line_rule" model="ir.rule">
        <field name="name">Project User Own Timesheet Rule</field>
        <field name="model_id" ref="analytic.model_account_analytic_line" />
        <field name="domain_force">[('user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('project.group_project_user'))]" />
        <field name="perm_create" eval="True" />
        <field name="perm_write" eval="True" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project.project_public_members_rule" model="ir.rule">
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project.task_visibility_rule" model="ir.rule">
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project.ir_rule_private_task" model="ir.rule">
        <field name="perm_create" eval="False" />
        <field name="perm_write" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>

    <record id="project_manager_remove_rating" model="ir.rule">
        <field name="name">Project Manager Ratings Rule</field>
        <field name="model_id" ref="rating.model_rating_rating" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_project.group_infomineo_project_manager'))]"
        />
    </record>

</odoo>
