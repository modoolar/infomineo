<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rating_rating_view_tree_task" model="ir.ui.view">
        <field name="name">rating.rating.view.tree.task</field>
        <field name="model">rating.rating</field>
        <field name="inherit_id" ref="project.rating_rating_view_tree_project" />
        <field name="arch" type="xml">
            <field name="create_date" position="after">
                <field name="rating_name_to" string="Rated by" />
            </field>
        </field>
    </record>

    <record id="rating_rating_action_project_task" model="ir.actions.act_window">
        <field name="name">Customer Ratings Tasks</field>
        <field name="res_model">rating.rating</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('res_model', '=', 'project.task')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No customer ratings yet
            </p><p>
                Let's wait for your customers to manifest themselves.
            </p>
        </field>
    </record>

    <record
        id="rating_rating_action_project_task_tree"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="10" />
        <field name="view_mode">tree</field>
        <field name="act_window_id" ref="rating_rating_action_project_task" />
        <field name="view_id" ref="rating_rating_view_tree_task" />
    </record>
</odoo>
