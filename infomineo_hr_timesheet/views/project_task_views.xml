<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_task_form2_inherited" model="ir.ui.view">
        <field name="name">project.task.form.inherited</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="hr_timesheet.view_task_form2_inherited" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='planned_hours']" position="attributes">
                <attribute name="invisible">True</attribute>
            </xpath>
            <xpath expr="//field[@name='planned_hours']" position="attributes">
                <attribute name="nolabel">0</attribute>
            </xpath>
            <xpath
                expr="//field[@name='timesheet_ids']/tree/field[@name='name']"
                position="after"
            >
                <field name="words_count" />
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="task_type_edit">
        <field name="name">task.type.edit</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_edit" />
        <field name="arch" type="xml">
            <field name="is_closed" position="after">
                <field name="is_new" />
            </field>
        </field>
    </record>

    <record model="ir.ui.view" id="task_type_tree">
        <field name="name">task.type.tree</field>
        <field name="model">project.task.type</field>
        <field name="inherit_id" ref="project.task_type_tree" />
        <field name="arch" type="xml">
            <field name="project_ids" position="after">
                <field name="is_new" />
            </field>
        </field>
    </record>

</odoo>
