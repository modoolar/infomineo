<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_employee_view_form" model="ir.ui.view">
        <field name="name">hr.employee.view.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <field name="department_id" position="attributes">
                <attribute
                    name="attrs"
                >{'required': [('approval_authorization_level_id', '!=', False)]}</attribute>
            </field>
            <field name="department_id" position="after">
                <field
                    name="approval_authorization_level_id"
                    options="{'no_quick_create':True,'no_create_edit':True,'no_open': True}"
                />
            </field>
            <group name="managers" position="inside">
                <field
                    name="approval_manager_id"
                    attrs="{'required': [('approval_authorization_level_id', '!=', False)]}"
                />
            </group>
        </field>
    </record>
</odoo>
