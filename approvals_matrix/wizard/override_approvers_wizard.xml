<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="override_approvers_wizard_view_form" model="ir.ui.view">
        <field name="name">override.approvers.wizard.form</field>
        <field name="model">override.approvers.wizard</field>
        <field name="arch" type="xml">
            <form>
                <footer>
                    <button
                        string="Approve"
                        class="btn-primary"
                        type="object"
                        name="action_approve"
                    />
                    <button string="Refuse" type="object" name="action_refuse" />
                    <button string="Discard" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
    <record id="override_approvers_wizard_action" model="ir.actions.act_window">
        <field name="name">Override Approval Request</field>
        <field name="res_model">override.approvers.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="override_approvers_wizard_view_form" />
    </record>
</odoo>
