<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="survey_auto_share_cron" model="ir.cron">
            <field name="name">Survey: Automatic Survey Share</field>
            <field name="model_id" ref="model_survey_survey"/>
            <field name="state">code</field>
            <field name="code">model.auto_send_survey_action()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

        <record id="survey_auto_remainder_cron" model="ir.cron">
            <field name="name">Survey: Automatic Survey Remainder Send</field>
            <field name="model_id" ref="model_survey_survey"/>
            <field name="state">code</field>
            <field name="code">model.auto_send_survey_remainder_action()</field>
            <field name="active" eval="True"/>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
        </record>

    </data>
</odoo>