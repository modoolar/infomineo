<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_asset_form" model="ir.ui.view">
        <field name='name'>view.account.asset.form</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_form" />
        <field name="arch" type="xml">
            <field name="acquisition_date" position="after">
                <field name="reference" />
                <field name="owner" />
                <field name="other_information" />
                <field name="disposed" readonly="1" />
            </field>
            <xpath expr="//field[@name='analytic_tag_ids']" position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('state', 'not in', ['draft', 'model'])]}</attribute>
            </xpath>
            <field name="first_depreciation_date" position="after">
                <field name="show_additional_bill_fields" invisible="1" />
                <field
                    name="payment_date"
                    attrs="{'invisible': [('show_additional_bill_fields', '=', False)]}"
                />
            </field>
        </field>
    </record>

    <record id="view_account_asset_form2" model="ir.ui.view">
        <field name="name">view.account.asset.form2</field>
        <field name="model">account.asset</field>
        <field name="priority">9999</field>
        <field
            name="inherit_id"
            ref="infomineo_account_asset.view_account_asset_form"
        />
        <field
            name="groups_id"
            eval="[(6, 0, [ref('account.group_account_manager')])]"
        />
        <field name="arch" type="xml">
            <field name='analytic_tag_ids' position="attributes">
                <attribute
                    name="attrs"
                >{'readonly': [('state', 'not in', ['draft', 'model', 'open'])]}</attribute>
            </field>
        </field>
    </record>

    <record id="view_account_asset_purchase_tree" model="ir.ui.view">
        <field name="name">view.account.asset.purchase.tree</field>
        <field name="model">account.asset</field>
        <field name="inherit_id" ref="account_asset.view_account_asset_purchase_tree" />
        <field name="arch" type="xml">
            <field name='acquisition_date' position="after">
                <field name="payment_date" optional="hide" />
            </field>
        </field>
    </record>
</odoo>
