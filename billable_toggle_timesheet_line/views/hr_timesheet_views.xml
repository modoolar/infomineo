<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_timesheet_line_tree_inherit" model="ir.ui.view">
        <field name="name">hr.timesheet.line.tree.inherit</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="sale_timesheet.hr_timesheet_line_tree_inherit" />
        <field name="arch" type="xml">
            <field name="so_line" position="after">
                <field name="previous_so_line_id" invisible="1" />
                <field optional="show" name="is_billable" widget="boolean_toggle" />
            </field>
        </field>
    </record>

    <record id="hr_timesheet_line_form_inherit" model="ir.ui.view">
        <field name="name">hr.timesheet.line.form.inherit</field>
        <field name="model">account.analytic.line</field>
        <field name="inherit_id" ref="sale_timesheet.hr_timesheet_line_form_inherit" />
        <field name="arch" type="xml">
            <field name="so_line" position="after">
                <field name="previous_so_line_id" invisible="1" />
                <field optional="show" name="is_billable" widget="boolean_toggle" />
            </field>
        </field>
    </record>

    <record id="timesheet_view_form_so_line_inherit" model="ir.ui.view">
        <field name="name">timesheet.view.form.so.line.inherit</field>
        <field name="model">account.analytic.line</field>
        <field
            name="inherit_id"
            ref="sale_timesheet_enterprise.timesheet_view_form_so_line_inherit"
        />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='so_line']" position="before">
                <field name="previous_so_line_id" invisible="1" />
                <field optional="show" name="is_billable" widget="boolean_toggle" />
            </xpath>
        </field>
    </record>
</odoo>
