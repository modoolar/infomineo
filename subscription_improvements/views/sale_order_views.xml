<?xml version="1.0" encoding="utf-8" ?>
<odoo>
     <record id="view_order_form" model="ir.ui.view">
        <field name="name">view.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="upsell_subscription_id" invisible="1" />
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form/group/group/field[@name='price_subtotal']"
                position="after"
            >
                <field name="is_recurring" invisible="1" />
                <field name="recurrency" />
                <field name="subtotal_recurring" />
                <field
                    name="recurring_tax_monthly"
                    t-options='{"widget": "monetary"}'
                    digits="[16, 2]"
                />
                <field
                    name="recurring_monthly"
                    t-options='{"widget": "monetary"}'
                    digits="[16, 2]"
                />
            </xpath>
            <xpath
                expr="//field[@name='order_line']//tree//field[@name='price_subtotal']"
                position="after"
            >
                <field name="is_recurring" invisible="1" />
                <field name="recurrency" optional='hidden' />
                <field name="subtotal_recurring" optional='hidden' />
                <field
                    name="recurring_tax_monthly"
                    t-options='{"widget": "monetary"}'
                    digits="[16, 2]"
                    optional='hidden'
                />
                <field
                    name="recurring_monthly"
                    t-options='{"widget": "monetary"}'
                    digits="[16, 2]"
                    optional='hidden'
                />
            </xpath>
         </field>
     </record>
</odoo>
