<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="sale_subscription_view_form">
        <field name="name">sale.subscription.view.form</field>
        <field name="model">sale.subscription</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='recurring_total']" position="after">
                <span>
                    <field name="recurrency" nolabel="1" />
                </span>
            </xpath>
            <xpath expr="//field[@name='recurring_total']" position="after">
                <field name="same_monthly_ratio" invisible="1" />
                <field
                    name="recurring_monthly"
                    t-options='{"widget": "monetary"}'
                    digits="[16, 2]"
                    attrs="{'invisible': [('same_monthly_ratio', '=', True)]}"
                />
            </xpath>

            <xpath
                expr="//button[@name='%(sale_subscription.wizard_action)d']"
                position="replace"
            >
                <button
                    string="Upsell"
                    name="wizard_action"
                    type="object"
                    attrs="{'invisible': [('stage_category', '!=', 'progress')]}"
                    data-hotkey="z"
                />
            </xpath>
            <xpath
                expr="//field[@name='recurring_invoice_line_ids']//tree/field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('subscription_template_id', '=', parent.template_id),('recurring_invoice', '=', True), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
