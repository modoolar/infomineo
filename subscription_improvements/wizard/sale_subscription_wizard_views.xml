<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="wizard_form_view" model="ir.ui.view">
        <field name="name">wizard.form.view</field>
        <field name="model">sale.subscription.wizard</field>
        <field name="inherit_id" ref="sale_subscription.wizard_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='option_lines']/tree/field[@name='product_id']"
                position="after"
            >
                <field name="sub_template_id" invisible="1" />
            </xpath>

            <xpath
                expr="//field[@name='option_lines']/tree/field[@name='quantity']"
                position="attributes"
            >
                <attribute name="string">Upsell Quantity</attribute>
            </xpath>

            <xpath
                expr="//field[@name='option_lines']/tree/field[@name='quantity']"
                position="after"
            >
                <field name="existing_qty" readonly="1" />
            </xpath>

            <xpath
                expr="//field[@name='option_lines']/tree/field[@name='product_id']"
                position="attributes"
            >
                <attribute
                    name="domain"
                >[('recurring_invoice', '=', True), ('subscription_template_id', '=', sub_template_id)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
