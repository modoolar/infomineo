<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="change_coach_wizard_view" model="ir.ui.view">
        <field name="name">Change Coach</field>
        <field name="model">change.coach.wizard</field>
        <field name="arch" type="xml">
            <form string="Change Coach">
                <group>
                    <field name="user_id" />
                </group>
                <group>
                    <field name="manager_id" />
                </group>
                <footer>
                    <button
                        name="change_coach"
                        class="btn-primary"
                        string="Update"
                        type="object"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
