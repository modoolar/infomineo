<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="hr_study_field_form" model="ir.ui.view">
        <field name="name">hr.study.field.form</field>
        <field name="model">hr.study.field</field>
        <field name="arch" type="xml">
            <form string="HR Study Field">
                <sheet>
                    <group>
                        <field name="name" />
                        <field name="is_active" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_study_field_tree" model="ir.ui.view">
        <field name="name">hr.study.field.tree</field>
        <field name="model">hr.study.field</field>
        <field name="arch" type="xml">
            <tree string="HR Study Field">
                <field name="name" />
                <field name="is_active" />
            </tree>
        </field>
    </record>

    <record id="hr_study_field_action" model="ir.actions.act_window">
        <field name="name">HR Study Field</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.study.field</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create new Hr Study Field
            </p>
        </field>
    </record>

    <menuitem
        id="menu_hr_study_field"
        name="Hr Study Field"
        action="hr_study_field_action"
        parent="hr.menu_config_plan"
        sequence="100"
    />
</odoo>
