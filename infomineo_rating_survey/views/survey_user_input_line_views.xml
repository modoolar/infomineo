<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="rating_rating_view_tree_input_line" model="ir.ui.view">
        <field name="name">rating.rating.tree.project</field>
        <field name="model">survey.user_input.line</field>
        <field name="arch" type="xml">
            <tree create="false" edit="false" default_order="create_date desc">
                    <field name="create_date" />
                    <field name="rated_partner_id" optional="show" />
                    <field
                    name="rated_partner_ids"
                    optional="show"
                    widget="many2many_tags"
                />
                    <field name="partner_id" optional="show" />
                    <field name="rating_name_to" optional="show" />
                    <field name="surveyed_by" optional="show" />
                    <field name="requestor_name" optional="show" />
                    <field name="client_contact" optional="show" />
                    <field name="parent_res_name" optional="show" />
                    <field name="res_name" optional="show" />
                    <field
                    name="rating_text"
                    decoration-success="rating_text == '1- very satisfied'"
                    decoration-info="rating_text == '2- satisfied'"
                    decoration-primary="rating_text == '3- neutral'"
                    decoration-warning="rating_text == '4- dissatisfied'"
                    decoration-danger="rating_text == '5- very dissatisfied'"
                    class="font-weight-bold"
                    widget="badge"
                />
                    <field name="survey_id" />
                    <field name="value_text_box" />
                    <field name="question_id" />
                    <field name="suggested_answer_id" string="Answer" />
            </tree>
        </field>
    </record>

    <record id="rating_rating_action_project_report" model="ir.actions.act_window">
        <field name="name">Customer Ratings</field>
        <field name="res_model">survey.user_input.line</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('consumed', '=', True)]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_empty_folder">
                No customer ratings yet
            </p><p>
                Let's wait for your customers to manifest themselves.
            </p>
        </field>
    </record>

    <record
        id="rating_rating_action_project_report_tree"
        model="ir.actions.act_window.view"
    >
        <field name="sequence" eval="10" />
        <field name="view_mode">tree</field>
        <field
            name="act_window_id"
            ref="infomineo_rating_survey.rating_rating_action_project_report"
        />
        <field name="view_id" ref="rating_rating_view_tree_input_line" />
    </record>
</odoo>
