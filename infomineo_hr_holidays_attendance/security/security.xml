<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.rule" id="infomineo_hr_manager_leave_rule">
        <field
            name="name"
        >HR Officer sees leaves for Employees where he is manager or PDC</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave" />
        <field
            name="domain_force"
        >['|',('employee_id.coach_id', '=', user.employee_id.id),('employee_id.parent_id', '=', user.employee_id.id)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record model="ir.rule" id="infomineo_hr_manager_leave_report_rule">
        <field
            name="name"
        >HR Officer sees leave report calendar for Employees where he is manager or PDC</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_report_calendar" />
        <field
            name="domain_force"
        >['|','|',('employee_id.user_id', '=', user.id),('employee_id.coach_id', '=', user.employee_id.id),('employee_id.parent_id', '=', user.employee_id.id)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record model="ir.rule" id="infomineo_hr_coach_leave_rule">
        <field name="name">HR Coach sees leaves for Employees where he is PDC</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave" />
        <field
            name="domain_force"
        >[('employee_id.coach_id', '=', user.employee_id.id)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_hr_attendance.group_hr_coach'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record model="ir.rule" id="infomineo_hr_coach_leave_report_rule">
        <field
            name="name"
        >HR Coach sees leave report calendar for Employees where he is PDC</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_report_calendar" />
        <field
            name="domain_force"
        >['|',('employee_id.user_id', '=', user.id),('employee_id.coach_id', '=', user.employee_id.id)]</field>
        <field
            name="groups"
            eval="[(4, ref('infomineo_hr_attendance.group_hr_coach'))]"
        />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record model="ir.rule" id="infomineo_hr_admin_leave_report_rule">
        <field
            name="name"
        >Employee Administrator sees leave report calendar for all Employees</field>
        <field name="model_id" ref="hr_holidays.model_hr_leave_report_calendar" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('hr.group_hr_manager'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
</odoo>
