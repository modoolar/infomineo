<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="account.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//div[@id='account_vendor_bills']" position="inside">
                    <div
                        class="col-xs-12 col-md-6 o_setting_box"
                        id="show_additional_bill_fields_group"
                    >
                        <div class="o_setting_left_pane">
                            <field name="show_additional_bill_fields" />
                        </div>
                        <div
                            class="o_setting_right_pane"
                            name="show_additional_bill_fields"
                        >
                            <label for="show_additional_bill_fields" />
                            <div class="text-muted">
                                Enable to show additional fields -Serie, UUID and Voucher Type-. Currently only used for Mexico.
                            </div>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
