<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_package_configurator_line_form_view" model="ir.ui.view">
        <field name="name">sale.package.configurator.line.form.view</field>
        <field name="model">sale.package.configurator.line</field>
        <field name="arch" type="xml">
            <form string="Sale Package Configurator Line">
                <sheet>
                    <div class="oe_title">
                        <label for="package_line_of_business" />
                        <h1>
                            <field name="package_line_of_business" />
                        </h1>
                    </div>
                     <group>
                        <group>
                            <field name="consumption_points" />
                            <field name="consumption_ratio" invisible="1" />
                        </group>
                        <group>
                            <field name="consumption_rate" />
                            <field name="reference_uom" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="sale_package_configurator_line_tree_view" model="ir.ui.view">
        <field name="name">sale.package.configurator.line.tree.view</field>
        <field name="model">sale.package.configurator.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="package_line_of_business" />
                <field name="consumption_points" />
                <field name="consumption_rate" />
                <field name="consumption_ratio" invisible="1" />
                <field name="reference_uom" />
            </tree>
        </field>
    </record>
</odoo>
