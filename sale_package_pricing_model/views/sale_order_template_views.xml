<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="sale_order_template_view_form" model="ir.ui.view">
        <field name="name">sale.order.template.view.form</field>
        <field name="model">sale.order.template</field>
        <field name="inherit_id" ref="sale_management.sale_order_template_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//label[@for='number_of_days']" position="before">
                <field
                    name="package_duration"
                    attrs="{'invisible': [('order_type', '!=', 'package')]}"
                />
                <field
                    name="package_size"
                    attrs="{'invisible': [('order_type', '!=', 'package')]}"
                />
                <field
                    name="package_configuration_id"
                    attrs="{'invisible': [('order_type', '!=', 'package')], 'required': [('order_type', '=', 'package')]}"
                />
            </xpath>
            <xpath expr="//page[@name='confirmation']" position="before">
                 <page
                    string="Package Configurator Lines"
                    name="configurator_lines"
                    attrs="{'invisible': [('order_type', '!=', 'package')]}"
                >
                     <field
                        name="package_configurator_line_ids"
                        attrs="{'invisible': [('order_type', '!=', 'package')]}"
                    />
                 </page>
            </xpath>
        </field>
    </record>
</odoo>
