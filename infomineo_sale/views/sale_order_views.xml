<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_order_tree" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_order_description.view_order_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_quotation_tree" model="ir.ui.view">
        <field name="name">sale.order.tree</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_order_description.view_quotation_tree" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='description']" position="attributes">
                <attribute name="optional">hide</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_form" model="ir.ui.view">
        <field name="name">sale.order.form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_order_description.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="description" position="move" />
            </xpath>
            <xpath expr="//field[@name='partner_shipping_id']" position="after">
                <field name="client_order_ref" position="move" />
            </xpath>
            <xpath expr="//group[@name='sale_total']" position="before">
                <group colspan="4">
                    <field
                        name="specific_condition"
                        placeholder="Specific conditions..."
                        nolabel="1"
                    />
                </group>
            </xpath>
        </field>
    </record>
</odoo>
