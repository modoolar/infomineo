<?xml version="1.0" ?>
<odoo>
    <record id="rating_rating_view_form_inherit_helpdesk" model="ir.ui.view">
        <field name="name">rating.rating.view.form.inherit.helpdesk</field>
        <field name="model">rating.rating</field>
        <field
            name="inherit_id"
            ref="helpdesk.rating_rating_view_form_inherit_helpdesk"
        />
        <field name="arch" type="xml">
            <field name="is_internal" position="after">
                <field name="feedback" position="move" />
            </field>
            <field name='feedback' position="attributes">
              <attribute name="string">Rating comment</attribute>
            </field>
        </field>
    </record>
</odoo>
