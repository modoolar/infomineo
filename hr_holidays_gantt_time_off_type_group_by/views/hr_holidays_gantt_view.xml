<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="hr_leave_report_calendar_view_gantt" model="ir.ui.view">
        <field name="name">hr.leave.report.calendar.view.gantt</field>
        <field name="model">hr.leave.report.calendar</field>
        <field
            name="inherit_id"
            ref="hr_holidays_gantt.hr_leave_report_calendar_view_gantt"
        />
        <field name="arch" type="xml">
            <field name="name" position="after">
                <field name="holiday_status_id" />
            </field>
            <xpath
                expr="//gantt/templates//div[@t-name='gantt-popover']"
                position="inside"
            >
                <div t-if="holiday_status_id"><strong>Type — </strong> <t
                        t-esc="holiday_status_id[1]"
                    /></div>
            </xpath>
        </field>
    </record>
</odoo>
