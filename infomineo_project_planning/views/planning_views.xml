<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="planning_view_search_inherit_planning_hr_skills" model="ir.ui.view">
        <field name="name">planning.view.search.inherit.planning.hr.skills</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_search" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='job_title']" position="after">
                <field name="hr_team_id" />
            </xpath>
        </field>
    </record>

    <record id="planning_view_form_in_gantt" model="ir.ui.view">
        <field name="name">planning.view.form.in.gantt</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form_in_gantt" />
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@special='save'][1]" position="attributes">
                <attribute name="groups" />
                <attribute name="groups">planning.group_planning_user</attribute>
            </xpath>
            <xpath expr="//footer/button[@special='save'][2]" position="attributes">
                <attribute name="groups" />
                <attribute name="groups">planning.group_planning_user</attribute>
            </xpath>
            <xpath expr="//footer/button[@name='action_send'][1]" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="groups"
                >infomineo_project_planning.group_staffing_manager</attribute>
            </xpath>
            <xpath expr="//footer/button[@name='action_send'][2]" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="groups"
                >infomineo_project_planning.group_staffing_manager</attribute>
            </xpath>
            <xpath expr="//footer/button[@name='action_publish']" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="groups"
                >infomineo_project_planning.group_staffing_manager</attribute>
            </xpath>
            <xpath
                expr="//footer/button[@name='action_unpublish']"
                position="attributes"
            >
                <attribute name="groups" />
                <attribute
                    name="groups"
                >infomineo_project_planning.group_staffing_manager</attribute>
            </xpath>
            <xpath expr="//footer/button[@special='cancel']" position="attributes">
                <attribute name="groups" />
                <attribute name="groups">planning.group_planning_user</attribute>
            </xpath>
            <xpath expr="//footer/button[@name='unlink']" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="groups"
                >infomineo_project_planning.group_staffing_manager</attribute>
            </xpath>
        </field>
    </record>

    <record id="planning_slot_report_view_form_in_gantt" model="ir.ui.view">
        <field name="name">planning.slot.report.view.form.in.gantt</field>
        <field name="model">planning.slot</field>
        <field
            name="inherit_id"
            ref="planning.planning_slot_report_view_form_in_gantt"
        />
        <field name="arch" type="xml">
            <xpath expr="//footer/button[@special='cancel']" position="attributes">
                <attribute name="groups" />
                <attribute
                    name="groups"
                >infomineo_project_planning.group_staffing_manager</attribute>
            </xpath>

        </field>
    </record>

    <record id="planning_slot_form" model="ir.ui.view">
        <field name="name">planning.slot.form</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_form" />
        <field name="arch" type="xml">
            <field name="allocated_percentage" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="allocated_hours" position="attributes">
                <attribute name="context">{'manual_change': True}</attribute>
            </field>
            <field name="end_datetime" position="attributes">
                <attribute name="readonly">1</attribute>
                <attribute name="force_save">1</attribute>
            </field>
        </field>
    </record>

    <record id="planning_view_search" model="ir.ui.view">
        <field name="name">planning.slot.search</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="planning.planning_view_search" />
        <field name="arch" type="xml">
            <field name="job_title" position="after">
                <field
                    name="category_ids"
                    string="Tags"
                    groups="planning.group_planning_user"
                />
            </field>
            <filter name="group_by_start_datetime" position="after">
                <filter
                    name="group_by_tags"
                    string="Tags"
                    context="{'group_by':'category_ids'}"
                />
                <filter
                    name="group_by_job_title"
                    string="Job Title"
                    context="{'group_by':'job_title'}"
                />
            </filter>
            <filter name="my_shifts" position="attributes">
                <attribute name="context">{'show_my_shifts': True}</attribute>
            </filter>
            <filter name="my_team_shifts" position="after">
                <filter
                    name="my_hr_team_shifts"
                    string="My HR Team"
                    domain="[('user_slot_ids', '=', True)]"
                    help="Shifts of Your HR Team"
                    context="{'my_hr_team_shifts': True}"
                />
            </filter>
        </field>
    </record>

</odoo>
